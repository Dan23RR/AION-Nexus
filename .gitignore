# Trained checkpoints: the three released models ARE shipped in-repo (~12 MB
# total) so that `clone + verify_checkpoint.py` works out of the box; other
# checkpoint artifacts stay out.
checkpoints/*.pth
checkpoints/*.onnx
checkpoints/*.pt
!checkpoints/aion_nexus_v1.pth
!checkpoints/aion_nexus_v6.pth
!checkpoints/aion_nexus_substrate_v3.pth

# Data (not in repo)
data/
*.csv
!examples/sample_signal.csv

# Certificate audit stores + calibration artifacts (deployment-specific, may hold
# real field data; built locally via scripts/build_calibration, never committed).
certificates.jsonl
*.certs.jsonl
checkpoints/calibration_*.npz
checkpoints/rul_*.joblib
*.rul.joblib

